# Environment config — copy to .env and fill in
GRAB_USERNAME=
GRAB_PASSWORD=
GRAB_MERCHANT_ID=dong-day
GRAB_TIMEZONE=Asia/Ho_Chi_Minh

# SQLite database file (default: data/delivery.db)
DB_PATH=

TELEGRAM_BOT_TOKEN=

# Scheduler (pnpm start)
SCHEDULE_CRON=30 6 * * *
# Re-fetch window in days (picks up late cancellations/refunds)
FETCH_TRAILING_DAYS=2
# Set to 1 to fetch all accounts immediately on server boot
RUN_ON_START=

# REST API port (pnpm start)
PORT=3000
