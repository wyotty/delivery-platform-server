# Environment config — copy to .env and fill in.
# Empty values are treated as "not set" and fall back to the defaults below.

# --- Platform credentials (per platform, prefix = platform name upper-cased) ---
GRAB_USERNAME=
GRAB_PASSWORD=
GRAB_MERCHANT_ID=dong-day
GRAB_TIMEZONE=Asia/Ho_Chi_Minh

# --- Storage ---
# SQLite database file (default: data/delivery.db)
DB_PATH=

# --- API server (src/index.ts) ---
HOST=
PORT=

# --- Scheduler ---
# node-cron expression for the fetch (default: */3 * * * * = every 3 minutes).
# Every 3 minutes is 480 runs a day, and line-item fetching is incremental enough to
# afford it: an unchanged order costs no request at all, so a quiet tick is one
# daily-report request per day in the trailing window and nothing else. Everything
# else on this page is scaled to that number — go faster and re-read the deadline note
# in src/platforms/grab/index.ts (itemDetail.deadlineMs) first, because a run that
# outlives its tick is skipped, not queued.
FETCH_CRON=
# Timezone the cron expression is evaluated in (default: Asia/Ho_Chi_Minh)
CRON_TIMEZONE=
# Set to true to also run the fetch once at startup (handy in sandbox)
FETCH_ON_BOOT=
# Days re-fetched on each run, to pick up late cancellations/refunds (default: 2).
# The range is [today - N, today]. KEEP THIS AT 2 OR MORE.
#
# Grab keeps correcting an order after its business day closes, and it serves the
# correction under the ORIGINAL day's report. Measured over the captured statements
# (2026-07-24..08-06, 315 of them): 11 orders were updated on a later ICT day than they
# were created and 2 a FULL 2 DAYS later (24 and the same 2 over the wider 781-statement
# survey) — including 001123099420-C8CURU3UGBCEUA, a cancellation created 07-28 and
# updated 2026-07-30T02:09:05Z that takes earnings to 0.
# With N=1 the 07-30 run covers only [07-29, 07-30], never re-reads 07-28, and the
# database keeps the pre-cancellation revenue forever, silently.
#
# Widening is nearly free now that line items are incremental: an unchanged order costs
# no detail call, so an extra day is ONE daily-report request per tick, not one per
# order. N=2 is 3 report requests a tick (~1,440/day); N=1 would save 480 of those and
# lose a real correction, which is the wrong trade in both directions.
#
# For anything older than the window — a parser fix, a correction that arrived a week
# late — run the backfill by hand; it is incremental too, so re-reading a month is
# cheap:
#   pnpm cli backfill grab <account> 2026-06-01 2026-06-30
FETCH_TRAILING_DAYS=

# --- Alerting (optional; unset = auth failures are logged only) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Logging ---
# trace | debug | info | warn | error (default: info)
LOG_LEVEL=
